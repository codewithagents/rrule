{
  "name": "rrule-ts-conformance",
  "version": "0.0.0",
  "private": true,
  "description": "Differential conformance harness for rrule-ts vs python-dateutil.",
  "type": "module",
  "scripts": {
    "gen:corpus": "node --import tsx/esm src/gen-corpus.ts",
    "fuzz": "node --import tsx/esm src/fuzz.ts",
    "sweep": "node --import tsx/esm src/sweep.ts",
    "sweep3": "node --import tsx/esm src/sweep3.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "rrule": "^2.8.1",
    "rrule-ts": "workspace:*",
    "temporal-polyfill": "catalog:",
    "tsx": "^4.19.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
